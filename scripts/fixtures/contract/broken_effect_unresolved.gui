				}
				moveable = no
				# ENGINE-REQUIRED: the engine resolves action_title / action_desc / option_list
				# INSIDE this container, so the container moved into the sidebar (the option_list is now
				# the sidebar navigation) while the two text targets keep their old on-screen position by
				# being offset out of the parent rect. PDX containers do not clip children unless
				# `clipping = yes` is set.
