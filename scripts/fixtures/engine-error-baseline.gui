#------------------------------------------------------------------------------------
# zz_geocentric_unga.gui
# Generated by RStellarisGui, then merged: one guiTypes root holding seven top-level
# containers (six windows + the engine-instantiated agenda option row).
# Geometry assumes a 1920x1080 base resolution; the game scales the UI.
#
# One mark-up block in this file was written by hand: the `listboxType` named
# `option_list` inside `unga_agenda`. The P1 emitter reports `listBoxType` as
# kind-not-emittable and writes nothing for it, so build.mjs splices it in using the
# position and size the plugin itself laid out and validated.
#------------------------------------------------------------------------------------

# Variables must be declared before guiTypes and cannot cross element nesting.
@unga_w = 1360
@unga_h = 780

guiTypes = {
	containerWindowType = {
		name = "geocentric_unga_main"
		position = {
			x = 0
			y = 0
		}
		size = {
			width = @unga_w
			height = @unga_h
		}
		orientation = center
		origo = center
		moveable = yes
		background = {
			name = "background"
			quadTextureSprite = "GFX_tile_large_bg_plain"
		}
		containerWindowType = {
			name = "unga_header_bg_main"
			position = {
				x = 16
				y = 16
			}
			size = {
				width = 1328
				height = 78
			}
			background = {
				name = "bg"
				quadTextureSprite = "GFX_tiles_dark_area_cut_8"
			}
		}
		iconType = {
			name = "unga_header_line_main"
			position = {
				x = 24
				y = 66
			}
			size = {
				width = 392
				height = 17
			}
			alwaysTransparent = yes
			spriteType = "GFX_line_medium"
		}
		iconType = {
			name = "unga_header_line_2_main"
			position = {
				x = 424
				y = 66
			}
			size = {
				width = 392
				height = 17
			}
			alwaysTransparent = yes
			spriteType = "GFX_line_medium"
		}
		iconType = {
			name = "unga_header_line_3_main"
			position = {
				x = 824
				y = 66
			}
			size = {
				width = 512
				height = 17
			}
			alwaysTransparent = yes
			spriteType = "GFX_line_long"
		}
		instantTextBoxType = {
			name = "unga_title_main"
			position = {
				x = 30
				y = 22
			}
			size = {
				width = 720
				height = 30
			}
			alwaysTransparent = yes
			font = "malgun_goth_24"
			text = "unga_title"
			maxWidth = 720
			maxHeight = 30
			fixedSize = yes
			format = left
		}
		instantTextBoxType = {
			name = "unga_subtitle_main"
			position = {
				x = 30

# --- fixture ends here: the remainder of the file is not needed to reproduce the engine errors ---
}
